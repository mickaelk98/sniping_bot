# ============================================================
# snipping_bot - configuration
# Copier en .env puis remplir. JAMAIS commiter .env, et ne
# jamais mettre de vraies clés dans ce fichier d'exemple.
# ============================================================

# --- Mode ---
# true = simulation complète, aucune transaction réelle envoyée.
# Toute nouvelle fonctionnalité doit être testée en dry-run d'abord.
DRY_RUN=true

# --- Wallet ---
# Clé privée d'un wallet DÉDIÉ au bot (jamais le wallet principal).
# Sur Base, alimenté en ETH natif.
PRIVATE_KEY=

# --- RPC ---
# WebSocket temps réel pour le listener PoolCreated (ex: QuickNode, Alchemy, wss://...)
BASE_WS_URL=
# RPC privé rapide pour l'exécution des transactions (https://...)
BASE_RPC_URL=

# --- Contrat helper (optionnel) ---
# Adresse du MultiHopSwap déployé. Vide = mode routeur direct (SwapRouter02 + WETH).
HELPER_CONTRACT_ADDRESS=

# --- Clés API ---
# Etherscan V2 (couvre Basescan) - https://etherscan.io/my-api-key
BASESCAN_API_KEY=

# --- Notifications (optionnel, au moins un) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Taille de trade et budgets ---
# Mode dynamique en USD (prioritaire) : montant = USD / prix ETH,
# prix lu on-chain via la pool WETH/USDC (aucune clé API nécessaire).
# TRADE_AMOUNT_USD=5
# ETH_PRICE_REFRESH_MINUTES=10
# Mode fixe en ETH, utilisé si TRADE_AMOUNT_USD est vide.
TRADE_AMOUNT_ETH=0.05
DAILY_BUDGET_ETH=0.5
MAX_OPEN_POSITIONS=3

# --- Exécution swap ---
MAX_SLIPPAGE_BPS=500
SWAP_DEADLINE_SECONDS=120

# --- Filtres risk-check ---
MIN_POOL_LIQUIDITY_ETH=2
MAX_HOLDER_PCT=50

# --- Position management (sortie asymétrique) ---
# Paliers take-profit : multiple:part-du-solde-restant-vendue
TAKE_PROFIT_TIERS=2:50,5:20,10:20,20:20,30:20,40:20,50:20,100:50
# Trailing stop : vente totale si chute de X% depuis le plus haut
# (actif après le premier palier, quand le capital est sécurisé)
TRAILING_STOP_PCT=20
STOP_LOSS_PCT=30
# Durée max de détention (heures) d'une position qui n'a franchi aucun palier
# de take-profit : vente totale au-delà pour libérer un slot et restituer du
# budget (0 = désactivé). Les positions gagnantes ne sont pas concernées.
MAX_HOLD_HOURS=6
POSITION_POLL_SECONDS=10
